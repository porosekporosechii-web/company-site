# ──────────────────────────────────────────────────────────────────
# Copy to .env.local for development, or set on the server in production.
# Never commit the real .env file.
# ──────────────────────────────────────────────────────────────────

# Public canonical URL of the site (used for SEO, sitemap, OG, canonical)
NEXT_PUBLIC_SITE_URL=https://rauco.ru

# Prisma DB connection
DATABASE_URL="file:./prisma/db.sqlite"

# NextAuth — required
NEXTAUTH_URL=http://localhost:3000
# Generate a 32+ char random string. In bash: openssl rand -base64 32
NEXTAUTH_SECRET=

# Admin credentials
ADMIN_USERNAME=admin
# Generate hash: npx tsx scripts/hash-password.ts <your-password>
ADMIN_PASSWORD_HASH=

# Where uploaded images are saved (relative to project root). Default: public/uploads
UPLOAD_DIR=public/uploads
