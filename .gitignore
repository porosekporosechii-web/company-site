# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output / cache ────────────────────────────────────
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ─── Env / secrets ───────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
# Keep the example committed — it's a template, no secrets in it.
!.env.example

# ─── Local DB (SQLite) ───────────────────────────────────────
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal
prisma/**/*.db
prisma/**/*.db-journal
prisma/**/*.sqlite
prisma/**/*.sqlite-journal
**/prisma/*.sqlite
**/prisma/*.db
prisma/prisma/db.sqlite
prisma/prisma/db.sqlite-journal

# ─── Uploaded files ──────────────────────────────────────────
/public/uploads/

# ─── Image-import workspace ──────────────────────────────────
# Source photos waiting to be processed and the bucket where the
# importer drops processed originals. Don't commit raw masters.
/upload/*
!/upload/.gitignore
!/upload/READ-ME.txt

# ─── Editor / OS ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.pem

# ─── Logs ────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Vercel ──────────────────────────────────────────────────
.vercel
